configuration {
  modes: [combi, calc];
  combi-modes: [drun, run];
  drun-display-format: "{name}";
}

* {
  font: "IoskeleyMono Nerd Font 14";
  bg: #282828;
  fg: #d4be98;
  accent: #e78a4e;
  urgent: #ea6962;
  active: #a9b665;
  selected-bg: #3c3836;
}

window {
  fullscreen: true;
  transparency: "real";
  padding: 36% 30%;
  background-color: #28282895;
  border-color: "transparent";
}

listview {
  border: 0;
  padding: 8 0 0;
  scrollbar: true;
}

scrollbar {
    width:        4px;
    border:       0;
    handle-color: @accent;
    handle-width: 8px;
    padding:      0 5;
}

entry {
  placeholder: "";
}

textbox {
  text-color: @fg;
}

element {
  border: 0;
  padding: 2px;
}

element.normal.normal {
  background-color: "transparent";
  text-color: @fg;
}

element.normal.urgent {
  background-color: "transparent";
  text-color: @urgent;
}

element.normal.active {
  background-color: "transparent";
  text-color: @active;
}

element.alternate.normal {
  background-color: "transparent";
  text-color: @fg;
}

element.alternate.urgent {
  background-color: "transparent";
  text-color: @urgent;
}

element.alternate.active {
  background-color: "transparent";
  text-color: @active;
}

element selected.normal {
  background-color: @selected-bg;
  text-color: @accent;
}

element selected.urgent {
  background-color: @selected-bg;
  text-color: @urgent;
}

element selected.active {
  background-color: @selected-bg;
  text-color: @active;
}

sidebar {
  border: 2px 0 0;
  border-color: @accent;
}

inputbar {
    spacing:    0;
    text-color: @accent;
    padding:    2px;
    children:   [ prompt, textbox-prompt-sep, entry, case-indicator ];
}

case-indicator,
entry,
prompt,
button {
    spacing:    0;
    text-color: @accent;
}

button.selected {
    background-color: @selected-bg;
    text-color:       @fg;
}

textbox-prompt-sep {
    expand:     false;
    str:        ":";
    text-color: @accent;
    margin:     0 0.3em 0 0;
}
